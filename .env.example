# ---------------------------------------------------------------------------
# Bhagyoday Belts IMS - copy to .env.local, then set the same values in
# Vercel > Settings > Environment Variables before deploying.
# ---------------------------------------------------------------------------

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Server only. Bypasses row level security - never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Voice entry. Free key from https://console.groq.com/keys
# Server only. If absent, the app falls back to the browser's own speech engine.
GROQ_API_KEY=gsk_...

# ---------------------------------------------------------------------------
# The admin account. This is the only place a role is configured; everyone
# else is assigned a role from Teams & Users inside the app.
#
# ADMIN_EMAIL is granted Super Admin on every sign-in, so it cannot be locked
# out or demoted from the interface. ADMIN_PASSWORD is used once, to create the
# Supabase Auth account if it does not exist yet; change the password in
# Supabase afterwards, not here.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=choose-a-strong-password
